basename-about =
  输出移除前导目录组件后的 NAME
  若指定，同时去除末尾的 SUFFIX
basename-usage =
  basename [-z] NAME [SUFFIX]
  basename OPTION... NAME...
basename-error-missing-operand = 缺少操作数
basename-error-extra-operand = 多余操作数 { $operand }
basename-help-multiple = 支持多个参数并将每个参数视为一个 NAME
basename-help-suffix = 删除一个后缀；隐含 -a
basename-help-zero = 每行输出以 NUL 结尾，而不是换行符
